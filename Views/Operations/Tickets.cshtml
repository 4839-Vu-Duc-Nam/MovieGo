@model IReadOnlyList<MovieGoApp.Models.TicketOperationRow>
@{
    ViewData["Title"] = "Quản lý vé";
}

<div class="section-heading">
    <div><p class="eyebrow">NGHIỆP VỤ NHÂN VIÊN</p><h1>Vé đã thanh toán</h1></div>
    <a class="btn btn-outline-primary" asp-action="Reports">Báo cáo doanh thu</a>
</div>
<p class="muted mb-4">Thực hiện trả hoặc đổi vé theo điều kiện trong đề tài. Giao dịch được lưu vào lịch sử và không xóa vé cũ.</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">Hiện chưa có vé đã thanh toán.</div>
}
else
{
    <div class="table-responsive operation-table">
        <table class="table align-middle">
            <thead><tr><th>Vé / hóa đơn</th><th>Phim / suất</th><th>Phòng · ghế</th><th>Giờ chiếu</th><th class="text-end">Giá vé</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td><strong>@ticket.TicketId</strong><div class="small muted">@ticket.InvoiceId</div></td>
                    <td>@ticket.MovieTitle</td>
                    <td>@ticket.RoomName · @ticket.Seat</td>
                    <td>@ticket.StartsAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">@ticket.Price.ToString("N0") ₫</td>
                    <td>
                        @if (ticket.IsCoupleSeat)
                        {
                            <span class="small muted">Ghế đôi phải xử lý theo cả cặp.</span>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Exchange" asp-route-id="@ticket.TicketId">Đổi vé</a>
                                <form asp-action="Return" method="post" onsubmit="return confirm('Xác nhận trả vé @ticket.TicketId?');">
                                    <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Trả vé</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
