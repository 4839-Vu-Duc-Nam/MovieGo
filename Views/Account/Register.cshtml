@model MovieGoApp.Models.RegisterForm
@{
    ViewData["Title"] = "Đăng ký khách hàng";
}

<section class="auth-card">
    <p class="eyebrow">MOVIEGO · TÀI KHOẢN KHÁCH</p>
    <h1>Tạo tài khoản</h1>
    <p class="muted">Tài khoản mới chỉ có quyền khách hàng; không thể tự đăng ký quyền quản trị.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Họ tên</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Số điện thoại <span class="muted">(không bắt buộc)</span></label>
            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu (ít nhất 8 ký tự)</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">Đăng ký</button>
    </form>
    <p class="mt-3 mb-0">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</section>
